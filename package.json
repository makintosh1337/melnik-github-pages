  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-scripts": "5.0.1",
    "typescript": "4.9.5",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.19.0"
  },
  "devDependencies": {
    "json-server": "0.17.4",
    "gh-pages": "6.3.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
