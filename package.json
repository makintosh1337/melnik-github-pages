  "scripts": {
    "start": "react-scripts start",
    "serve": "json-server --watch ./src/server/db/index.js --routes ./src/server/routes.json --port 3001",
    "build": "react-scripts build && node ./src/server/scripts/save-json-api.js",
    "predeploy": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && npm run build",
